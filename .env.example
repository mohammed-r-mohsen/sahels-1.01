APP_NAME=sahels
APP_ENV=development
API_PORT=8080
API_HOST=0.0.0.0

JWT_SECRET=replace-with-long-random-secret
JWT_EXPIRY_SECONDS=86400

DATABASE_URL=postgresql://sahels:sahels_secure_password@localhost:5432/sahels
REDIS_URL=redis://localhost:6379/0

ENCRYPTION_KEY=base64:AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=

RATE_LIMIT_REQUESTS_PER_MINUTE=60
RATE_LIMIT_BURST=10

CORS_ALLOWED_ORIGINS=http://localhost:5173

# Clinic integration tokens
CLINIC_PAYMENT_TOKEN=replace-clinic-payment-token
CLINIC_WHATSAPP_TOKEN=replace-whatsapp-token
CLINIC_INSTAGRAM_TOKEN=replace-instagram-token
CLINIC_API_TOKEN=replace-clinic-api-token
CLINIC_OTP_SECRET=replace-otp-secret
CLINIC_OTP_TTL_SECONDS=300

# Backup configuration
BACKUP_DIR=/opt/sahels/backups
BACKUP_RETENTION_DAYS=30

# Email / notifications
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=sahels@example.com
SMTP_PASS=replace-password
SMTP_FROM="Sahels <noreply@example.com>"
